# Database
DATABASE_URL="postgresql://dramapro_app:password@127.0.0.1:5432/dramapro"
DIRECT_URL="postgresql://dramapro_app:password@127.0.0.1:5432/dramapro"

# App
NEXT_PUBLIC_SITE_URL=https://layardrama.id
TELEGRAM_MINI_APP_URL=https://layardrama.id
CRON_SECRET=change-me

# Admin
ADMIN_EMAIL=admin@layardrama.id
ADMIN_PASSWORD=change-me
ADMIN_NAME="Layar Drama Admin"

# StreamAPI catalog
STREAMAPI_TOKEN=
PROVIDER_TIMEOUT_MS=20000
PROVIDER_SYNC_IDLE_MS=3000
CATALOG_DETAIL_TTL_MINUTES=360

# StreamAPI cron enqueue
PROVIDER_CRON_PROVIDERS=all
PROVIDER_CRON_SECTIONS=default
PROVIDER_CRON_PAGE_START=1
PROVIDER_CRON_PAGE_COUNT=1
PROVIDER_CRON_DRY_RUN=0

# Worker runtime
WORKER_BASE_URL=https://layardrama.id

# Promo downloader
FFMPEG_PATH=ffmpeg
FFMPEG_LOG_LEVEL=error
PROMO_DOWNLOAD_INTERNAL_ORIGIN=http://127.0.0.1:3001
PROMO_DOWNLOAD_SUBTITLE_STYLE="FontName=Arial,FontSize=14,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,BorderStyle=1,Outline=1,Shadow=0,MarginV=38,Alignment=2"
PROMO_DOWNLOAD_TOKEN_SECRET=change-me
PROMO_DOWNLOAD_TOKEN_TTL_MINUTES=60
PROMO_DOWNLOAD_DIR=storage/promo-downloads
PROMO_DOWNLOAD_IDLE_MS=3000
PROMO_DOWNLOAD_MIN_FREE_MB=1024
PROMO_DOWNLOAD_MIN_DURATION_SECONDS=15

# Payment
PAYMENKU_API_KEY=
PAYMENT_CREDENTIALS_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SUPPORT_URL=
