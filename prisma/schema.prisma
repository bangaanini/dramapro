generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProviderName {
  melolo
  meloshort
  goodshort
  dramawave
  reelshort
  freereels
  flickreels
  netshort
}

model Drama {
  id              String       @id @default(uuid()) @db.Uuid
  providerDramaId String
  providerName    ProviderName
  title           String
  description     String       @default("")
  thumbUrl        String       @default("")
  episodeCount    Int          @default(0)
  watchValue      String       @default("")
  isNewBook       Boolean      @default(false)
  tags            String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([providerName, providerDramaId])
  @@index([providerName, updatedAt])
}

model AdminUser {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  name         String
  passwordHash String
  sessions     AdminSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  adminUserId String    @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([adminUserId, expiresAt])
}
