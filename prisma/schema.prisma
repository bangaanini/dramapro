generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProviderName {
  melolo
  meloshort
  goodshort
  dramawave
  dramabox
  reelshort
  freereels
  flickreels
  netshort
}

enum FeedSource {
  home
  new
  popular
}

model Drama {
  id              String       @id @default(uuid()) @db.Uuid
  providerDramaId String
  providerName    ProviderName
  title           String
  description     String       @default("")
  thumbUrl        String       @default("")
  episodeCount    Int          @default(0)
  watchValue      String       @default("")
  isNewBook       Boolean      @default(false)
  tags            String[]     @default([])
  feedEntries     DramaFeed[]
  favorites       FavoriteDrama[]
  watchHistory    WatchHistory[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([providerName, providerDramaId])
  @@index([providerName, updatedAt])
}

model DramaFeed {
  id        String     @id @default(uuid()) @db.Uuid
  dramaId   String     @db.Uuid
  source    FeedSource
  drama     Drama      @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([dramaId, source])
  @@index([source, updatedAt])
}

model AdminUser {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  name         String
  passwordHash String
  sessions     AdminSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  adminUserId String    @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([adminUserId, expiresAt])
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  name         String
  passwordHash String
  sessions     UserSession[]
  favorites    FavoriteDrama[]
  watchHistory WatchHistory[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model FavoriteDrama {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  dramaId   String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama     Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, dramaId])
  @@index([userId, createdAt])
}

model WatchHistory {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  dramaId             String   @db.Uuid
  episodeIndex        Int      @default(1)
  lastPositionSeconds Int      @default(0)
  watchedAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama               Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)

  @@unique([userId, dramaId])
  @@index([userId, updatedAt])
  @@index([dramaId, updatedAt])
}

model VipSettings {
  id              String   @id @default("global")
  isEnabled       Boolean  @default(false)
  lockFromEpisode Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VipPricePlan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String   @default("")
  priceAmount Int
  currency    String   @default("IDR")
  durationDays Int
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}
